{
  "Version": "2012-10-17",
  "Statement": [{
    "Sid": "PublicReadDashboardAndOutputs",
    "Effect": "Allow",
    "Principal": "*",
    "Action": "s3:GetObject",
    "Resource": [
      "arn:aws:s3:::YOUR-BUCKET/index.html",
      "arn:aws:s3:::YOUR-BUCKET/status.json",
      "arn:aws:s3:::YOUR-BUCKET/runs.json",
      "arn:aws:s3:::YOUR-BUCKET/runs/*"
    ]
  }]
}
